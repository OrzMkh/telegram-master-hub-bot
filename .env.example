# Master Hub Bot — токен основного Master Hub бота
BOT_TOKEN=your_master_hub_bot_token_here

# Пароль для входа в веб-панель
MASTER_APP_PASSWORD=change_me_in_production

# Токен бота уведомлений задач (telegram-task-manager-bot)
# Используется для отправки уведомлений о задачах в группу
TASK_BOT_TOKEN=your_task_bot_token_here

# ID Telegram-группы для уведомлений о задачах
TASK_CHAT_ID=-1002638798110

# Токен бота флита (telegram-bike-report-bot), опционально
FLEET_BOT_TOKEN=your_fleet_bot_token_here

# Sibling Bot URLs
RICH_BOT_URL=https://telegram-rich-bike-bot.onrender.com
FLEET_BOT_URL=https://telegram-bike-report-bot.onrender.com

# Web App
WEB_APP_URL=https://telegram-master-hub-bot.onrender.com

# Секрет для внутреннего API между ботами (придумай случайную строку)
INTERNAL_API_SECRET=change_me_to_random_secret

# Database (PostgreSQL на Render, оставить пустым для локального SQLite)
DATABASE_URL=

# Google Sheets (Base64 JSON ключа сервисного аккаунта, только для Render)
GOOGLE_CREDENTIALS_JSON=

# Server
PORT=8085
